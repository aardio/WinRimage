import process.rimage;
import fonts.fontAwesome;

var parent,controller = ...;
controller=controller : {};
var model=controller.model : rimage.guiModel.create();
controller.model=model;
var exePath=controller.exePath : string.getenv("WINRIMAGE_RIMAGE_EXE") : io.fullpath("/res/rimage.exe");
var task=null;
var taskTimer=null;
/*DSG{{*/
var winform = win.form(text="批量处理";right=1180;bottom=678;bgcolor=0xF4F6FA;border="none")
winform.add(
