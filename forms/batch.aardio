/*}}*/

var model=controller.model;
var values=function(){ return rimage.uiValues.read(winform); };
var exePath=controller.exePath : string.getenv("WINRIMAGE_RIMAGE_EXE") : io.fullpath("/res/rimage.exe");
var errorText=function(err){
    if(!err) return "未知错误";
    var text=tostring(err.message : err);
    if(err.code) text="[" ++ tostring(err.code) ++ "] " ++ text;
    if(err.path) text ++= '\r\n路径：' ++ tostring(err.path);
    if(err.plan && err.plan.errors){
        for(i,item in err.plan.errors){
            if(i==1) text ++= '\r\n原因：' ++ tostring(item.message);
            elseif(i<=5) text ++= '\r\n- ' ++ tostring(item.message);
        }
        if(#err.plan.errors>5) text ++= '\r\n- 以及其他 ' ++ tostring(#err.plan.errors-5) ++ ' 个问题';
    }
    if(err.result && err.result.stderr && #err.result.stderr) text ++= '\r\n' ++ string.trim(err.result.stderr);
    return text;
};
var executableError=function(){
    var info,err=process.rimage.detect(exePath);
    return info,err;
};
winform.encoder.selIndex=1;
winform.resizeMode.selIndex=1;
winform.resizeFilter.selIndex=1;
winform.resizeDirection.selIndex=1;
winform.quantizationEnabled.checked=false;
winform.outputDir.text=controller.defaultOutputDirectory : io.fullpath("/output");
winform.cancel.disabled=true;
winform.fileList.columns=[["文件",-1],["大小",86],["状态",84]];
winform.fileList.enableDoubleBuffering();
winform.progress.setProgressRange(0,100);

var updateList=function(keepStatus){
    winform.fileList.items=rimage.guiModel.fileRows(model);
    winform.countLabel.text=#model.files ? ("队列：" ++ tostring(#model.files) ++ " 个文件") : "队列为空";
};
winform.updateList=updateList;
var updateResizeControls=function(){
    var original=winform.resizeMode.selIndex==1;
    winform.resizeValue.disabled=original;
    winform.resizeFilter.disabled=original;
    winform.resizeDirection.disabled=original;
};
var refreshPlan=function(){
    var p,err=rimage.guiModel.plan(model,values());
    if(!p){ winform.status.text="配置错误：" ++ errorText(err); winform.status.background=0xFFFFE8E8; return null,err; }
    if(!p.safe){ var detail={code="unsafePlan";plan=p;message="执行计划未通过安全检查"}; winform.status.text="计划有风险：" ++ errorText(detail); winform.status.background=0xFFFFE8E8; return p,detail; }
    if(!task){ winform.status.text="计划安全，可开始处理"; winform.status.background=0xFFE8EEF5; }
    return p;
};
var finishTask=function(){
    if(!task) return;
    var snap=task.snapshot(),state=snap.state : "starting";
    if(state=="starting" || state=="running" || state=="cancelling"){
        winform.status.text="正在批量处理…（" ++ state ++ "）";
        winform.progress.visible=true; winform.progress.progressPos=35;
        return;
    }
    if(snap.error){
        rimage.guiModel.setAllStatus(model,"失败");
        winform.status.text="任务失败：" ++ errorText(snap.error);
        winform.status.background=0xFFFFE8E8;
    }
    elseif(snap.result){
        var r=snap.result,total=0;
        rimage.guiModel.applyResult(model,r);
        for(i,item in r.outputs) total += item.size : 0;
        winform.progress.progressPos=100;
        winform.status.text=string.format("处理完成：成功 %d · 失败 %d · 输出 %s",r.successCount : 0,r.failedCount : 0,rimage.guiModel.formatBytes(total));
        winform.status.background=0xFFE5F7EC;
    }
    updateList();
    winform.start.disabled=false; winform.cancel.disabled=true;
    if(taskTimer){ winform.clearInterval(taskTimer); taskTimer=null; }
    task.close(); task=null;
};
var openSingle=function(){
    var index=winform.fileList.selIndex;
    if(index && model.files[index] && controller.openSingle) controller.openSingle(model.files[index]);
};
winform.openSingle.oncommand=openSingle;
winform.fileList.onDoubleClick=function(item,subItem,nmListView){ if(item>0 && model.files[item] && controller.openSingle) controller.openSingle(model.files[item]); };
winform.addFiles.oncommand=function(){
    var files=fsys.dlg.openMulti("图像|*.jpg;*.jpeg;*.png;*.webp;*.avif;*.bmp;*.tif;*.tiff;*.jxl|所有文件|*.*|","添加图像文件");
    if(files){ rimage.guiModel.addFiles(model,files); updateList(); refreshPlan(); }
};
winform.addDir.oncommand=function(){
    var dir=fsys.dlg.dir(,,"添加图像文件夹");
    if(dir){ rimage.guiModel.addDirectory(model,dir); updateList(); refreshPlan(); }
};
winform.removeFile.oncommand=function(){
    var index=winform.fileList.selIndex;
    if(index) rimage.guiModel.removeAt(model,index);
    updateList(); refreshPlan();
};
winform.clearFiles.oncommand=function(){
    if(task) return;
    rimage.guiModel.clear(model); updateList(); refreshPlan();
};
winform.onDropFiles=function(files){
    if(controller.routeDrop) controller.routeDrop(files);
    else { rimage.guiModel.addInputs(model,files); updateList(); refreshPlan(); }
};
winform.encoder.onSelChange=function(){ rimage.uiValues.syncEncoder(winform); refreshPlan(); };
winform.quantizationEnabled.oncommand=function(){ rimage.uiValues.syncPreprocess(winform); refreshPlan(); };
winform.resizeMode.onSelChange=function(){ updateResizeControls(); refreshPlan(); };
winform.resizeFilter.onSelChange=refreshPlan;
winform.resizeDirection.onSelChange=refreshPlan;
winform.quality.onKillFocus=refreshPlan;
winform.resizeValue.onKillFocus=refreshPlan;
winform.quantization.onKillFocus=refreshPlan;
winform.dithering.onKillFocus=refreshPlan;
winform.outputDir.onKillFocus=refreshPlan;
winform.suffix.onKillFocus=refreshPlan;
winform.preserve.oncommand=refreshPlan;
winform.strip.oncommand=refreshPlan;
winform.start.oncommand=function(){
    if(task) return;
    if(!#model.files){ winform.msgbox("请先添加图片文件。","无法开始","info"); return; }
    var p,planErr=refreshPlan();
    if(!p || !p.safe){
        var detail=planErr;
        if(!detail) detail={code="unsafePlan";plan=p;message="执行计划未通过安全检查"};
        winform.msgbox(errorText(detail),"无法开始","warn");
        return;
    }
    var exeInfo,exeErr=executableError();
    if(!exeInfo){ winform.msgbox(errorText(exeErr),"无法开始","error"); return; }
    var newTask,err=process.rimage.runAsync(p.config,model.files,{exePath=exePath});
    if(!newTask){ winform.msgbox(tostring(err.message : err),"启动失败","error"); return; }
    task=newTask; rimage.guiModel.setAllStatus(model,"处理中"); updateList();
    winform.start.disabled=true; winform.cancel.disabled=false; winform.progress.visible=true; winform.progress.progressPos=15;
    winform.status.text="正在启动 rimage…"; winform.status.background=0xFFFFF4D6;
    taskTimer=winform.setInterval(finishTask,120);
};
winform.cancel.oncommand=function(){ if(task){ task.cancel(); winform.status.text="正在取消…"; } };
rimage.uiValues.syncEncoder(winform); rimage.uiValues.syncPreprocess(winform); updateResizeControls(); updateList();
winform.onDestroy=function(){
    if(task){ task.cancel(); var s=task.wait(3000); if(s) task.close(); task=null; }
    if(taskTimer){ winform.clearInterval(taskTimer); taskTimer=null; }
};
return winform;
