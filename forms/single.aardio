preview={cls="plus";left=18;top=96;right=810;bottom=574;bgcolor=0xE3EAF2;border={color=0xCBD5E1;radius=10;width=1};color=0x64748B;db=1;dl=1;dt=1;font=LOGFONT(h=-16);z=9};
previewOutput={cls="plus";text="生成预览";left=980;top=522;right=1138;bottom=552;bgcolor=0xE8F1FC;border={color=0xB7D3F5;radius=5;width=1};color=0x1769AA;dr=1;font=LOGFONT(h=-13;weight=600);iconStyle={align="left";font=LOGFONT(h=-13;name='FontAwesome');padding={left=12}};iconText='\uF06E';notify=1;textPadding={left=34};z=33};
processImage={cls="plus";text="处理此图";left=980;top=562;right=1138;bottom=616;bgcolor=0x2474D2;border={color=0x2474D2;radius=7;width=1};color=0xFFFFFF;dr=1;font=LOGFONT(h=-15;weight=600);iconStyle={align="left";font=LOGFONT(h=-14;name='FontAwesome');padding={left=14}};iconText='\uF1D8';notify=1;textPadding={left=39};z=35};
