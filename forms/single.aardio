import fsys;
import fsys.dlg;
import fsys.dlg.dir;
import rimage.guiModel;
import rimage.preview;
import rimage.clipboard;
import rimage.uiValues;
import process.rimage;
import gdip.webp;
import fonts.fontAwesome;

var parent,controller = ...;
/*DSG{{*/
var winform = win.form(text="单图处理";right=1180;bottom=678;bgcolor=0xF4F6FA;border="none")
winform.add(
browseOutput={cls="plus";text="选择目录";left=854;top=522;right=972;bottom=552;bgcolor=0xFFFFFF;border={color=0xD5DCE5;radius=5;width=1};color=0x334155;dr=1;font=LOGFONT(h=-13);iconStyle={align="left";font=LOGFONT(h=-13;name='FontAwesome');padding={left=8}};iconText='\uF07C';notify=1;textPadding={left=28};z=32};
